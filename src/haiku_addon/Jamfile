# Haiku accelerant add-on (ADR-004, fase 2).
#
# app_server carga el add-on por la firma que devuelve el kernel con
# B_GET_ACCELERANT_SIGNATURE ("radeon_legacy.accelerant"), por lo que el
# nombre del binario debe ser exactamente radeon_legacy.accelerant.
#
# Uso (desde el arbol de Haiku):
#   jam -sRG_REPO=/ruta/AMD-DriverRadeonLegacy radeon_legacy.accelerant

SubDir HAIKU_TOP src add-ons accelerants radeon_legacy ;

if $(RG_REPO) = "" {
	Echo "RG_REPO no definido: jam -sRG_REPO=/ruta/AMD-DriverRadeonLegacy" ;
	Exit 1 ;
}

SEARCH on [ FGristFiles radeon_legacy_driver.cpp ] =
	[ FDirName $(RG_REPO) src haiku_addon ] ;
SEARCH on [ FGristFiles rg_asic.cpp ] =
	[ FDirName $(RG_REPO) src server asic ] ;

# El acelerador habla con el kernel solo por ioctl; no enlaza common ni
# libaccelerantscommon.
Addon radeon_legacy.accelerant :
	radeon_legacy_driver.cpp
	rg_asic.cpp
	:
	be ;
